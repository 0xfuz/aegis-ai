# Production Compose template: placeholders only.  Store secret values in
# root-readable files outside this repository and pass only their paths here.
POSTGRES_USER_REQUIRED=<production-db-user>
POSTGRES_DB_REQUIRED=<production-db-name>
POSTGRES_PASSWORD_FILE_REQUIRED=/secure/path/postgres-password
JWT_SECRET_KEY_FILE_REQUIRED=/secure/path/jwt-signing-secret
CORS_ORIGINS_REQUIRED=https://aegis.example.invalid
PUBLIC_API_BASE_URL_REQUIRED=https://api.aegis.example.invalid
NEXT_PUBLIC_API_URL_REQUIRED=https://api.aegis.example.invalid
API_PORT=8000
FRONTEND_PORT=3000

# Disabled by default.  When enabled, the fixed model identity is supplied by
# docker-compose.production.yml and must already exist in the Ollama volume.
INTELLIGENCE_EXECUTION_ENABLED=false
INTELLIGENCE_DISPATCH_ENABLED=false
INTELLIGENCE_PROVIDER_ENABLED=false

# Required only with `--profile bootstrap`; values are identifiers, not secrets.
BOOTSTRAP_ORGANIZATION_NAME_REQUIRED=<organization-name>
BOOTSTRAP_ORGANIZATION_SLUG_REQUIRED=<organization-slug>
BOOTSTRAP_ADMIN_EMAIL_REQUIRED=<admin@example.invalid>
BOOTSTRAP_ADMIN_FULL_NAME_REQUIRED=<administrator-name>
BOOTSTRAP_ADMIN_PASSWORD_FILE=/secure/path/bootstrap-admin-password
