# --- Postgres ---
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis_dev_password
POSTGRES_DB=aegis_ai
POSTGRES_PORT=5432

# --- Backend ---
JWT_SECRET_KEY=CHANGE_ME_dev_only_insecure_secret
ENVIRONMENT=development
DEBUG=true
SEED_DEMO_DATA=true
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:3000
BACKEND_PORT=8000
PUBLIC_API_BASE_URL=http://localhost:8000

# --- AI reasoning ---
# AI_PROVIDER selects which backs the "Analyze" button:
#   'gemini'    — free within Gemini's rate limits, but only in countries
#                 Google's free tier supports (get a key at
#                 https://aistudio.google.com — if you get an HTTP 429 with
#                 "limit: 0", your account isn't eligible for the free tier)
#   'anthropic' — get a key at https://console.anthropic.com (paid, trial credit only)
#   'ollama'    — fully local, no key needed, no regional restrictions at
#                 all, but slower and lower-quality than a cloud model.
#                 Requires: docker compose up -d ollama, then
#                 docker compose exec ollama ollama pull llama3.2 (one-time,
#                 several GB download) before it'll work.
# Leave cloud keys blank to run without AI analysis — the button shows a
# clear "not configured" error instead of crashing.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2

# --- Redis ---
REDIS_PORT=6379

# --- Canonical evidence ingestion ---
# Keep this path outside public/static directories. Evidence is available only
# through authenticated controlled-download endpoints.
EVIDENCE_STORAGE_DIR=/app/storage/evidence
MAX_EVIDENCE_BYTES=5242880
MAX_RAW_RECORD_LENGTH=65536
MAX_RAW_RECORDS=10000
MAX_EVENTS=10000
MAX_EXTRACTED_INDICATORS=50000
MAX_EXTRACTED_ENTITIES=50000
MAX_JSON_DEPTH=32

# --- Frontend ---
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ⚠ These defaults are for local development ONLY. Before any non-local
# deployment: generate a real JWT_SECRET_KEY (e.g. `openssl rand -hex 32`),
# set a strong POSTGRES_PASSWORD, set ENVIRONMENT=production, DEBUG=false,
# and restrict CORS_ORIGINS to your real frontend origin(s).
